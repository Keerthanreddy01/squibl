# ─────────────────────────────────────────────────────────────────────────────
# Squibl — Root .env.example
#
# This monorepo uses TWO separate .env files:
#   • frontend/.env.local      ← Next.js client (copy from frontend/.env.example)
#   • backend/.env             ← Express API  (copy from backend/.env.example)
#
# Do NOT put real secrets here. This file is committed and public.
# See each subfolder's .env.example for the full variable list.
# ─────────────────────────────────────────────────────────────────────────────

# ─── FRONTEND (frontend/.env.local) ──────────────────────────────────────────
# Supabase Project URL & Anon Key (safe to expose in browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API base URL (no trailing slash)
# Local dev: http://localhost:5000
# Production: https://your-api.example.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional Server-Only Secrets for Frontend (API routes)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── BACKEND (backend/.env) ──────────────────────────────────────────────────
# Server
PORT=5000
NODE_ENV=development

# Supabase Server SDK
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# CORS — allowed frontend origin
FRONTEND_URL=http://localhost:3000

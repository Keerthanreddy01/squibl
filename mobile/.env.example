# ─────────────────────────────────────────────────────────────────────────────
# Squibl Mobile — .env.example
#
# Copy this file to `mobile/.env` for local development.
# EXPO_PUBLIC_* variables are embedded in the client JavaScript bundle.
#
# NEVER commit real credentials to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ─── SUPABASE ────────────────────────────────────────────────────────────────
# Found in: Supabase Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── BACKEND API ─────────────────────────────────────────────────────────────
# Local development on Android Emulator uses 10.0.2.2 instead of localhost
# For real device, use your local network IP (e.g. http://192.168.1.x:5000)
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
